# UniFilter AI v5 — 環境変数のサンプル（実値は .env.local / Vercel の Environment Variables に入れる）
# ※ このファイルはサンプル。実際の値を入れた .env / .env.local は .gitignore によりコミットされません。

# Google Cloud Console > 認証情報 > OAuth クライアント ID（ウェブアプリケーション）
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# 承認済みリダイレクト URI（Google Cloud 側の登録値と完全一致させる）
# ローカル開発: http://localhost:3000/api/auth/callback
# 本番(Vercel): https://<あなたのアプリ名>.vercel.app/api/auth/callback
# 本番では未設定でも VERCEL_URL から自動生成されるが、明示設定を推奨。
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
